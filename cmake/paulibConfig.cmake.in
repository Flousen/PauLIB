@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenMP COMPONENTS CXX)

include("${CMAKE_CURRENT_LIST_DIR}/paulibTargets.cmake")

# Optional components: only resolved when they were part of the install, so a
# consumer without MPI/CUDA can still use the core target.
#   find_package(paulib REQUIRED COMPONENTS mpi gpu)
if(TARGET paulib::mpi)
    find_package(MPI QUIET COMPONENTS CXX)
    set(paulib_mpi_FOUND ${MPI_CXX_FOUND})
endif()
if(TARGET paulib::gpu)
    find_package(CUDAToolkit QUIET)
    set(paulib_gpu_FOUND ${CUDAToolkit_FOUND})
endif()

check_required_components(paulib)
